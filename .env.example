# --- Supabase (optional in der Beta: ohne diese Werte greift ein In-Memory-Rate-Limit) ---
# Eigenes Supabase-Projekt für den Sanierungsrechner (Org energetisiert).
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
# Publishable Key genügt — die Rate-Limit-RPC ist SECURITY DEFINER mit
# EXECUTE für anon, ein Service-Role-Key wird nicht benötigt.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key aus diesem Projekt>

# --- Security ---
# Salt für SHA-256(IP + Salt) beim Rate Limiting — nie Klartext-IPs speichern (DSGVO).
IP_SALT=<zufaelliger-langer-string>
# Secret für kurzlebige, signierte Request-Tokens (HMAC). In Produktion setzen,
# damit Tokens über mehrere Serverless-Instanzen hinweg gültig sind.
REQUEST_TOKEN_SECRET=<zufaelliger-langer-string>
# Erlaubte Origins für Berechnungs-Requests (kommagetrennt). Standard:
# https://sanierungsrechner.energetisiert.de,https://energetisiert.de
# ALLOWED_ORIGINS=

# Vercel BotID benötigt keinen manuellen Secret Key.
